{
  "name": "@pennsieve/timeseries-zarr-reader",
  "version": "0.0.0",
  "description": "Reads pyramid Zarr v3 time-series bundles in the browser or Node.js and yields per-channel segments for rendering.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/stores/file.d.ts",
      "default": "./dist/stores/file.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix . && prettier --write .",
    "format:check": "prettier --check .",
    "check": "eslint . && prettier --check . && tsc --noEmit && vitest run && pnpm build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "dependencies": {
    "fili": "^2.0.3",
    "p-limit": "^7.3.1",
    "zarrita": "^0.7.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false
}
